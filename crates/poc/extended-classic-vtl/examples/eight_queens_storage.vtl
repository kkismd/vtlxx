; ８クイーンの全92解を逐一表示し、状態の置き場所を使い分ける例。
; リポジトリ直下から ecvtl にこのファイルを渡して実行する。
; storage[0..7] は列ごとの候補行の正本。0 は空、1..8 は行を表す。
; storage[8] は解数の正本。この例の実行には16セル以上の storage が必要。
; C は現在の列と探索の深さを保持する。R は衝突判定中だけ使う候補行のキャッシュ。
; R は手続きの復帰後に保持すべき状態ではない。X と Y は寿命が重ならない手続きで再利用する。

  ; a: ( 差 -- 絶対値 )。スタックを読み、Y を破壊する。storage は読み書きしない。
  |=a
    Y=[
    %=Y<0 [ Y=0-Y ]
    [=Y
  a=|

  ; c: ( -- 衝突 )。C と storage[0..C] を読み、X、Y、R を破壊する。
  ; storage は書かず、衝突なら1、衝突しなければ0をスタックへ返す。
  ; X は走査位置、R はこの呼び出し中だけ有効な storage[C] のキャッシュ。
  |=c
    R=@(C)
    X=0
    *=()
    |=
      [=X<C
    =|
    |=
      %=@(X)==R [ X=C ] |=
        a=@(X)-R
        Y=[
        %=Y==(C-X) [ X=C ]
      =|
      X=X+1
    =|
    [=X>C
  c=|

  ; o: ( -- )。storage[0..7] を読み、X と出力を変更する。
  ; 完成した解を列順に1行ずつ表示する。X は c の走査位置と共用する。
  |=o
    X=0
    *=()
    |=
      [=X<8
    =|
    |=
      ?=@(X)
      X=X+1
    =|
    ?=()
  o=|

  ; d: ( -- )。C を読み書きし、次の列の storage を0にする。
  ; 一時レジスタは破壊しない。
  |=d
    C=C+1
    @=C,0
  d=|

  ; b: ( -- )。C と現在列の storage を読み書きし、候補を消して戻る。
  ; 一時レジスタは破壊しない。
  |=b
    @=C,0
    C=C-1
  b=|

  ; s: ( -- )。C と storage[0..8] を読み書きし、全解を出力する。
  ; c、o、d、b を呼ぶため X、Y、R は破壊される。呼び出しをまたいで保持しない。
  |=s
    *=()
    |=
      [=C>=0
    =|
    |=
      ; 候補の更新は常に storage[C] の値を基準にする。
      @=C,@(C)+1
      %=@(C)>8 [ b=() ] |=
        c=()
        ; 衝突結果をスタックから消費し、空いた候補だけを進める。
        %=[==0 |=
          %=C==7 |=
            @=8,@(8)+1
            o=()
          =| [ d=() ]
        =|
      =|
    =|
  s=|

  C=0
  @=C,0
  @=8,0
  s=()
  ; 全探索が終わった後に storage[8] の解数を表示する。
  ?=@(8)
  ?=()
