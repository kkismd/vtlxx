; Evaluate the fixed token program 3 4 ADD 2 MUL 7 SUB and print 7.
; storage[0..6] holds tokens: 0..32767 are operands, -1 is ADD,
; -2 is SUB, and -3 is MUL. This encoding belongs only to this example.
; P is the next token address; T is the current token. A and B are
; operator scratch. The runtime value stack itself holds RPN operands.

  ; a: ( lhs rhs -- result ). Reads/writes A and B; leaves P, T and
  ; storage unchanged. B takes the top (rhs), then A takes lhs.
  &=a [
    B=~
    A=~
    ~=A+B
  ]

  ; s: ( lhs rhs -- result ). Reads/writes A and B; leaves P, T and
  ; storage unchanged. Operand order is lhs minus rhs.
  &=s [
    B=~
    A=~
    ~=A-B
  ]

  ; m: ( lhs rhs -- result ). Reads/writes A and B; leaves P, T and
  ; storage unchanged.
  &=m [
    B=~
    A=~
    ~=A*B
  ]

  ; e: ( -- result ). Reads storage[0..6], writes P and T, and calls
  ; a, s, m (which clobber A and B). Existing stack values below the
  ; calculator operands survive the loop and its procedure calls.
  &=e [
    P=0
    *=()
    [
      ~=P<7
    ]
    [
      T=@(P)
      P=P+1
      %=T>=0 [ ~=T ] [
        %=T==-1 [ a=() ]
        %=T==-2 [ s=() ]
        %=T==-3 [ m=() ]
      ]
    ]
  ]

  ; Initialize the fixed program in indexed storage before evaluation.
  @=0,3
  @=1,4
  @=2,-1
  @=3,2
  @=4,-3
  @=5,7
  @=6,-2

  e=()
  ?=~
  ?=()
