; Game storage layout and quadrant contents.
.DEVICE_BASE := 64
.DEVICE_END := 71
.SECTOR_BASE := 71
.ENEMY_HP_BASE := 135
.ENEMY_X_BASE := 141
.ENEMY_Y_BASE := 147
.ENEMY_END := 153
.MISSION_DAYS := 160
.SHIP_ENERGY := 161
.SHIP_TORPEDOES := 162
.GALAXY_ENEMIES := 163
.GALAXY_BASES := 164
.QUADRANT_X := 165
.QUADRANT_Y := 166
.SHIP_X := 167
.SHIP_Y := 168
.QUADRANT_ENEMIES := 169
.DOCKED := 170
.PRNG_STATE := 192
.PRNG_MULTIPLIER := 25173
.PRNG_INCREMENT := 13849
.OBSERVED_FLAG := 1000
.ENEMY_HP := 300
.ASCII_TAB := 9
.ASCII_LF := 10
.ASCII_CR := 13
.ASCII_SPACE := 32
.ASCII_PLUS := 43
.ASCII_MINUS := 45
.ASCII_ZERO := 48
.ASCII_NINE := 57
.INT_PREFIX := -3276
.PARSE_VALID := 1
.PARSE_INVALID := 0
.PARSE_EOF := -1
.COURSE_MAX := 360
.COURSE_STEP := 90
.COURSE_SCALE := 45
.COURSE_VALID := 1
.COURSE_EOF := -1
.HIT_SCALE := 30
.ENEMY_UNIT := 100
.BASE_KIND := 2
.ENERGY_MAX := 4000
.TORPEDO_MAX := 10
.DEVICE_LIMIT := 70
.SECTOR_LIMIT := 8
.DAMAGE_TRIGGER := 200
.ENEMY_SLOTS := 6
.MISSION_CONTINUE := 0
.MISSION_WIN := 1
.MISSION_LOSE := 2
.WARP_HALF := 22
.WARP_WRAP := 360
.WARP_DENOM := 110
.WARP_STOP := -23
.STORM_BOUND := 7
.STORM_VALUE := 3
.WARP_MAX := 89
.DAMAGED_WARP_MAX := 2
.COMMAND_CANCEL := 0
.COMMAND_COMMIT := 1
.COMMAND_EOF := -1
.PHASER_OVERLOAD := 500
.OVERLOAD_POWER := 9
.TORPEDO_DAMAGE := 500
.BASE_UNIT := 10
.STAR_KIND := 3
.MAP_EMPTY := 46
.MAP_ENEMY := 75
.MAP_BASE := 66
.MAP_STAR := 42
.MAP_SHIP := 69
.STARDATE_BASE := 3230
.LOW_ENERGY := 1000
.ASCII_LOWER_A := 97
.ASCII_LOWER_Z := 122
.ASCII_CASE := 32
.CMD_G := 71
.CMD_L := 76
.CMD_S := 83
.CMD_P := 80
.CMD_R := 82
.CMD_W := 87
.CMD_T := 84
.CMD_HELP := 63
.CMD_X := 88

; Bounded PRNG ( n -- value ). Caller supplies 1..32767.
; Writes A, B and storage[192].
  &=r [
    A=~
    B=(@(.PRNG_STATE)*.PRNG_MULTIPLIER)+.PRNG_INCREMENT
    @=.PRNG_STATE,B
    B=B%A
    %=B<0 [ B=B+A ]
    ~=B+1
  ]

; Device display ( device-id -- ). Reads the device; writes A and B.
  &=t [
    A=~ B=@(.DEVICE_BASE+A-1)
    %=A==1 [ ?="*SHORT RANGE SENSOR*" ]
    %=A==2 [ ?="*COMPUTER*" ]
    %=A==3 [ ?="*LONG RANGE SENSOR*" ]
    %=A==4 [ ?="*PHASER*" ]
    %=A==5 [ ?="*WARP*" ]
    %=A==6 [ ?="*TORPEDOES*" ]
    %=B!=0 [
      ?="DAMAGED!" ?=() ?=B ?=() ?=" YEARS ESTIMATED FOR REPAIR."
    ]
    ?=()
  ]

; Long-range scan ( -- ). Direct scratch I, J, K, L; t clobbers A, B.
; Marks only in-range galaxy cells as observed; no PRNG draws.
  &=l [
    ?="NOW: QUADRANT(" ?=@(.QUADRANT_X) ?=@(.QUADRANT_Y)
    ?=") SECTOR(" ?=@(.SHIP_X) ?=@(.SHIP_Y) ?=")" ?=()
    t=3
    %=@(.DEVICE_BASE+2)==0 [
      I=@(.QUADRANT_X)-1
      *=I<=(@(.QUADRANT_X)+1) [
        ?=I J=@(.QUADRANT_Y)-1
        *=J<=(@(.QUADRANT_Y)+1) [
          ?=" "
          %=((I>=1)*(I<=.SECTOR_LIMIT))*((J>=1)*(J<=.SECTOR_LIMIT)) [
            L=((I-1)*.SECTOR_LIMIT)+J-1 K=@(L)
            %=K<.OBSERVED_FLAG [ @=L,K+.OBSERVED_FLAG ]
            K=K%.OBSERVED_FLAG
            ?=K/100 ?=(K/10)%10 ?=K%10
          ] [ ?="***" ]
          J=J+1
        ]
        ?=() I=I+1
      ]
      ?=" ..." ?=@(.QUADRANT_Y)-1 ?="..." ?=@(.QUADRANT_Y)
      ?="..." ?=@(.QUADRANT_Y)+1 ?=()
    ]
  ]

; Galaxy map ( -- ). Scratch I, J, K; reads galaxy without changing storage.
  &=m [
    ?=() ?="########## GARAXY MAP ##########" ?=()
    I=0
    *=I<.SECTOR_LIMIT [
      J=0
      *=J<.SECTOR_LIMIT [
        K=@((I*.SECTOR_LIMIT)+J)
        ?=" "
        %=K<.OBSERVED_FLAG [ ?="***" ] [
          K=K-.OBSERVED_FLAG
          ?=K/100 ?=(K/10)%10 ?=K%10
        ]
        J=J+1
      ]
      ?=() I=I+1
    ]
    ?=() ?=" ..1...2...3...4...5...6...7...8" ?=()
  ]

; Short-range scan ( -- ). Direct scratch I, J, K; t clobbers A, B.
; Reads the sector and device state without changing storage or drawing random numbers.
  &=s [
    ?="NOW: QUADRANT(" ?=@(.QUADRANT_X) ?=@(.QUADRANT_Y)
    ?=") SECTOR(" ?=@(.SHIP_X) ?=@(.SHIP_Y) ?=")" ?=()
    t=1
    %=@(.DEVICE_BASE)==0 [
      I=1
      *=I<=.SECTOR_LIMIT [
        ?=I J=1
        *=J<=.SECTOR_LIMIT [
          K=@(.SECTOR_BASE+((I-1)*.SECTOR_LIMIT)+J-1)
          ?=" "
          %=K==0 [ $=.MAP_EMPTY ]
          %=K==1 [ $=.MAP_ENEMY ]
          %=K==.BASE_KIND [ $=.MAP_BASE ]
          %=K==.STAR_KIND [ $=.MAP_STAR ]
          %=K==4 [ $=.MAP_SHIP ]
          J=J+1
        ]
        ?=() I=I+1
      ]
      ?="  1 2 3 4 5 6 7 8" ?=()
    ]
  ]

; Status report ( -- ). Reads game storage; no register or storage writes.
  &=v [
    ?="*STATUS REPORT*" ?=() ?=()
    ?="*STARDATE : " ?=.STARDATE_BASE-@(.MISSION_DAYS) ?=() ?=()
    ?="*CONDITION: "
    %=@(.DOCKED)!=0 [ ?="DOCKED" ] [
      %=@(.QUADRANT_ENEMIES)>0 [ ?="RED" ] [
        %=@(.SHIP_ENERGY)<.LOW_ENERGY [ ?="YELLOW" ] [ ?="GREEN" ]
      ]
    ]
    ?=()
    ?="*QUADRANT : (" ?=@(.QUADRANT_X) ?=@(.QUADRANT_Y) ?=")" ?=()
    ?="*SECTOR...: (" ?=@(.SHIP_X) ?=@(.SHIP_Y) ?=")" ?=()
    ?="*ENERGY...: " ?=@(.SHIP_ENERGY) ?=() ?=()
    ?="*TORPEDOES: " ?=@(.SHIP_TORPEDOES) ?=()
    ?="*KLINGON..: " ?=@(.GALAXY_ENEMIES) ?=()
    ?="*BASE.....: " ?=@(.GALAXY_BASES) ?=()
  ]

; Random damage event ( -- ). Writes the selected device and PRNG state;
; r and t clobber A and B. The first draw is protected on the value stack.
  &=j [
    r=6
    r=3
    B=~ A=~
    @=.DEVICE_BASE+A-1,@(.DEVICE_BASE+A-1)+B
    t=A
  ]

; Hit calculation ( power enemy-slot -- damage ). Reads positions;
; writes scratch A..F, without changing storage or drawing random numbers.
  &=h [
    A=~ B=~
    C=@(.ENEMY_X_BASE+A-1)-@(.SHIP_X)
    D=@(.ENEMY_Y_BASE+A-1)-@(.SHIP_Y)
    E=(C*C)+(D*D)+.HIT_SCALE
    F=B/E
    ~=((.HIT_SCALE*F)+((.HIT_SCALE*(B%E))/E))+1
  ]

; Counterattack ( -- ). I and T hold the slot and total across r/h;
; direct scratch H, I, S, T, U, and transitive scratch A..F.
; Writes live enemy HP, ship energy, PRNG, and optionally one device.
  &=a [
    %=@(.QUADRANT_ENEMIES)>0 [
      ?="*KLINGON ATTACK" ?=()
      %=@(.DOCKED)!=0 [
        ?="STARBASE PROTECT ENTERPRISE." ?=()
      ] [
        I=1 T=0
        *=I<=.ENEMY_SLOTS [
          H=@(.ENEMY_HP_BASE+I-1)
          %=H>0 [
            r=H U=~ U=(U-1)/2
            @=.ENEMY_HP_BASE+I-1,H-U
            ~=U h=I S=~ T=T+S
            ?=S ?=" UNITS HIT FROM KLINGON ("
            ?=@(.ENEMY_X_BASE+I-1) ?=@(.ENEMY_Y_BASE+I-1) ?=")" ?=()
          ]
          I=I+1
        ]
        @=.SHIP_ENERGY,@(.SHIP_ENERGY)-T
        %=T>=.DAMAGE_TRIGGER [
          ?="## SHIELD SCREEN FELL DOWN ##" ?=()
          j=()
        ]
      ]
    ]
  ]

; Apply a hit ( enemy-slot damage -- ). Writes scratch A..D and, on
; destruction, the selected HP, sector, galaxy cell and enemy totals.
  &=k [
    B=~ A=~
    C=@(.ENEMY_HP_BASE+A-1)-B
    %=C<=1 [
      @=.ENEMY_HP_BASE+A-1,0
      C=@(.ENEMY_X_BASE+A-1) D=@(.ENEMY_Y_BASE+A-1)
      @=.SECTOR_BASE+((C-1)*8)+D-1,0
      C=(@(.QUADRANT_X)*8)+@(.QUADRANT_Y)-9
      @=C,@(C)-.ENEMY_UNIT
      @=.GALAXY_ENEMIES,@(.GALAXY_ENEMIES)-1
      @=.QUADRANT_ENEMIES,@(.QUADRANT_ENEMIES)-1
    ] [
      @=.ENEMY_HP_BASE+A-1,C
    ]
  ]

; Dock and resupply ( -- ). Reads adjacent in-range sectors; writes
; DOCKED and, when docked, energy, torpedoes and devices 64..69.
; Scratch A, B, I, J; no callees or PRNG draws.
  &=d [
    A=@(.SHIP_X) B=@(.SHIP_Y)
    @=.DOCKED,0
    I=A-1
    *=I<=(A+1) [
      J=B-1
      *=J<=(B+1) [
        %=(I>=1)*(I<=.SECTOR_LIMIT)*(J>=1)*(J<=.SECTOR_LIMIT) [
          %=(I!=A)+(J!=B) [
            %=@(.SECTOR_BASE+((I-1)*.SECTOR_LIMIT)+J-1)==.BASE_KIND [
              @=.DOCKED,1
            ]
          ]
        ]
        J=J+1
      ]
      I=I+1
    ]
    %=@(.DOCKED)==1 [
      @=.SHIP_ENERGY,.ENERGY_MAX @=.SHIP_TORPEDOES,.TORPEDO_MAX
      I=.DEVICE_BASE *=I<.DEVICE_LIMIT [ @=I,0 I=I+1 ]
      ?="DOCKED IN" ?=()
    ]
  ]

; End a committed turn ( -- mission-result ). d/a own all state writes;
; no direct scratch writes, transitive scratch A..F, H, I, J, S, T, U.
  &=u [
    %=@(.GALAXY_ENEMIES)==0 [
      ~=.MISSION_WIN
    ] [
      d=() a=()
      %=@(.GALAXY_ENEMIES)==0 [ ~=.MISSION_WIN ] [
        %=(@(.SHIP_ENERGY)<=0)+(@(.MISSION_DAYS)<=0) [
          ~=.MISSION_LOSE
        ] [ ~=.MISSION_CONTINUE ]
      ]
    ]
  ]

; Generate a complete galaxy ( -- ). Writes galaxy[0..63],
; GALAXY_ENEMIES, GALAXY_BASES, PRNG state and scratch A, B, C,
; H, I, J, L, M, T. T is the current attempt's enemy total.
; H holds the enemy distribution parameter across calls and retries.
  &=g [
    r=400
    H=~+599
  ^=1
    I=0 C=0 T=0
    *=I<64 [
      r=100
      J=~-1
      J=J<5
      C=C+J
      r=H
      L=~-1
      M=(L<209)+(L<49)+(L<24)+(L<9)+(L<2)
      T=T+M
      r=8
      L=~-1
      @=I,(M*100)+(J*10)+L
      I=I+1
    ]
    %=(C==0)+(C>=4) [ #=1 ]
    @=.GALAXY_ENEMIES,T @=.GALAXY_BASES,C
  ]

; Expand the current quadrant ( -- ). Reads quadrant/ship coordinates
; and galaxy from storage; writes QUADRANT_ENEMIES, sector[71..134],
; enemy[135..152] and PRNG state.
; Scratch C, H, I, J, L, M, P, R; r clobbers A and B.
  &=q [
    I=.SECTOR_BASE
    *=I<.ENEMY_END [ @=I,0 I=I+1 ]
    @=.SECTOR_BASE+((@(.SHIP_X)-1)*8)+(@(.SHIP_Y)-1),4
    M=@((@(.QUADRANT_X)*8)+@(.QUADRANT_Y)-9)%.OBSERVED_FLAG
    H=M/100
    @=.QUADRANT_ENEMIES,H
    P=(M%100)/10
    R=M%10
    C=1 I=1
    *=C<=3 [
      *=H>0 [
      ^=1
        r=64
        J=~-1
        M=.SECTOR_BASE+J
        %=@(M)!=0 [ #=1 ]
        @=M,C
        %=C==1 [
          L=(J/8)+1
          J=(J%8)+1
          @=.ENEMY_HP_BASE+I-1,.ENEMY_HP
          @=.ENEMY_X_BASE+I-1,L
          @=.ENEMY_Y_BASE+I-1,J
          I=I+1
        ]
        H=H-1
      ]
      C=C+1
      %=C==2 [ H=P ]
      %=C==3 [ H=R ]
    ]
  ]

; Committed warp trajectory ( distance dx dy -- ). S/T retain direction,
; U/V fixed-point coordinates, W remaining distance, X crossing flag,
; Y step length and Z termination state across r/j. q runs only at the end.
; Direct scratch A..D, S..Z; transitive also q's C,H,I,J,L,M,P,R.
  &=x [
    T=~ S=~ W=~
    W=W*.COURSE_SCALE
    U=(@(.SHIP_X)*.COURSE_SCALE)+.WARP_HALF
    V=(@(.SHIP_Y)*.COURSE_SCALE)+.WARP_HALF
    A=S %=A<0 [ A=0-A ]
    B=T %=B<0 [ B=0-B ]
    %=B<A [ A=B ]
    Y=((A*A)+.COURSE_SCALE)/.WARP_DENOM+.COURSE_SCALE
    X=0 Z=0
    *=Z==0 [
      W=W-Y
      %=W<=.WARP_STOP [ Z=1 ] [
        ?=@(.QUADRANT_X) ?=@(.QUADRANT_Y) ?="-"
        ?=@(.SHIP_X) ?=@(.SHIP_Y) ?=()
        U=U+S V=V+T
        C=U/.COURSE_SCALE D=V/.COURSE_SCALE
        %=(C>=1)*(C<=.SECTOR_LIMIT)*(D>=1)*(D<=.SECTOR_LIMIT) [
          %=X==0 [
            %=@(.SECTOR_BASE+((C-1)*.SECTOR_LIMIT)+D-1)!=0 [
              ?="*** EMERGENCY STOP ***" ?=()
              ?="SPOCK : TO ERR IS HUMAN !" ?=()
              j=() Z=1
            ] [ @=.SHIP_X,C @=.SHIP_Y,D ]
          ] [ @=.SHIP_X,C @=.SHIP_Y,D ]
        ] [
          @=.QUADRANT_X,@(.QUADRANT_X)+(C==9)-(C==0)
          @=.QUADRANT_Y,@(.QUADRANT_Y)+(D==9)-(D==0)
          U=U+(.WARP_WRAP*(C==0))-(.WARP_WRAP*(C==9))
          V=V+(.WARP_WRAP*(D==0))-(.WARP_WRAP*(D==9))
          @=.SHIP_X,U/.COURSE_SCALE @=.SHIP_Y,V/.COURSE_SCALE
          %=X==0 [ ?="*WARP ENGINE START" ?=() X=1 ]
          %=(@(.QUADRANT_X)<1)+(@(.QUADRANT_X)>.SECTOR_LIMIT)+(@(.QUADRANT_Y)<1)+(@(.QUADRANT_Y)>.SECTOR_LIMIT) [
            ?=" OUTSIDE THE GARAXY !!" ?=()
            ?="ON BOARD COMPUTER TAKES OVER," ?=()
            j=()
            r=8 A=~ @=.QUADRANT_X,A
            r=8 A=~ @=.QUADRANT_Y,A
            @=.SHIP_X,@(.QUADRANT_Y) @=.SHIP_Y,@(.QUADRANT_X)
            q=() Z=2
          ]
        ]
      ]
    ]
    %=Z==1 [
      %=X==0 [ @=.SECTOR_BASE+((@(.SHIP_X)-1)*.SECTOR_LIMIT)+@(.SHIP_Y)-1,4 ]
      r=.STORM_BOUND A=~
      %=A==.STORM_VALUE [ ?="## SPACE STORM ##" ?=() j=() ]
      %=X==1 [ q=() ]
      ?="NOW: QUADRANT(" ?=@(.QUADRANT_X) ?=@(.QUADRANT_Y)
      ?=") SECTOR(" ?=@(.SHIP_X) ?=@(.SHIP_Y) ?=")" ?=()
    ]
  ]

; Initialize a mission ( -- ). The caller seeds PRNG once at startup.
; Writes the game state, PRNG via g/q/r, and scratch A, B, C,
; H, I, J, L, M, P, R, T.
  &=i [
    @=.MISSION_DAYS,30 @=.SHIP_ENERGY,4000 @=.SHIP_TORPEDOES,10 @=.DOCKED,0
    I=.DEVICE_BASE *=I<.DEVICE_END [ @=I,0 I=I+1 ]
    g=()
    r=8 A=~ @=.QUADRANT_X,A
    r=8 A=~ @=.QUADRANT_Y,A
    @=.SHIP_X,@(.QUADRANT_Y) @=.SHIP_Y,@(.QUADRANT_X)
    q=()
  ]

; Decimal line parser ( -- value status ). No storage writes or callees;
; scratch A..H are caller-saved. B is leading/sign/digits/trailing/CR/invalid
; (0..5), C is negative, D accumulates negatively, E records any input.
  &=n [
    B=0 C=0 D=0 E=0 F=1
    *=F [
      A=$
      %=(A==.ASCII_LF)+(A==.PARSE_EOF) [
        F=0
      ] [
        E=1 H=B
        %=H==4 [ B=5 ]
        %=(H<4)*(A==.ASCII_CR) [
          B=5
          %=(H==2)+(H==3) [ B=4 ]
        ] [
          %=(H==0)+(H==1) [
            %=(A==.ASCII_SPACE)+(A==.ASCII_TAB) [
              %=H==1 [ B=5 ]
            ] [
              %=(A==.ASCII_PLUS)+(A==.ASCII_MINUS) [
                B=5
                %=H==0 [ B=1 C=A==.ASCII_MINUS ]
              ] [
                B=5
                %=(A>=.ASCII_ZERO)*(A<=.ASCII_NINE) [
                  B=2 D=.ASCII_ZERO-A
                ]
              ]
            ]
          ]
          %=H==2 [
            %=(A==.ASCII_SPACE)+(A==.ASCII_TAB) [ B=3 ] [
              B=5
              %=(A>=.ASCII_ZERO)*(A<=.ASCII_NINE) [
                G=A-.ASCII_ZERO
                %=(D>.INT_PREFIX)+((D==.INT_PREFIX)*(G<=(7+C))) [
                  D=(D*10)-G B=2
                ]
              ]
            ]
          ]
          %=H==3 [
            %=(A!=.ASCII_SPACE)*(A!=.ASCII_TAB) [ B=5 ]
          ]
        ]
      ]
    ]
    %=(B==2)+(B==3)+(B==4) [
      %=C==0 [ D=0-D ]
      ~=D ~=.PARSE_VALID
    ] [
      ~=0
      %=(A==.PARSE_EOF)*(E==0) [ ~=.PARSE_EOF ] [ ~=.PARSE_INVALID ]
    ]
  ]

; Course input ( -- dx dy status ). Direct scratch A..F; n adds G, H.
; No storage writes; input and COURSE prompt are the only effects.
  &=c [
  ^=1
    ?="COURSE: "
    n=()
    B=~ A=~
    %=B==.PARSE_EOF [ ~=0 ~=0 ~=.COURSE_EOF #=2 ]
    %=(B!=.PARSE_VALID)+(A<0)+(A>.COURSE_MAX) [ #=1 ]
    C=(A+.COURSE_SCALE)/.COURSE_STEP
    D=A-(C*.COURSE_STEP)
    %=((C==0)+(C==4)) [ E=0-.COURSE_SCALE F=D ]
    %=C==1 [ E=D F=.COURSE_SCALE ]
    %=C==2 [ E=.COURSE_SCALE F=0-D ]
    %=C==3 [ E=0-D F=0-.COURSE_SCALE ]
    ~=E ~=F ~=.COURSE_VALID
  ^=2
  ]

; Phaser ( -- command-status ). I is the slot and J is the fixed power;
; h/k/t clobber A..F, while n clobbers A..H. No PRNG draws.
  &=f [
    t=4
    %=@(.DEVICE_BASE+3)>0 [ ~=.COMMAND_CANCEL #=3 ]
  ^=1
    ?="ENERGY ? " n=()
    B=~ A=~
    %=B==.PARSE_EOF [ ~=.COMMAND_EOF #=3 ]
    %=(B!=.PARSE_VALID)+(A<0) [ #=1 ]
    %=A==0 [ ~=.COMMAND_CANCEL #=3 ]
    %=A>@(.SHIP_ENERGY) [
      ?="SORRY ! WE HAVE ONLY " ?=@(.SHIP_ENERGY) ?=" UNITS" ?=() #=1
    ]
    @=.SHIP_ENERGY,@(.SHIP_ENERGY)-A
    %=@(.QUADRANT_ENEMIES)==0 [ ?="MISSED!!" ?=() ] [
      J=A/@(.QUADRANT_ENEMIES)
      I=1
      *=I<=.ENEMY_SLOTS [
        %=@(.ENEMY_HP_BASE+I-1)>0 [
          %=J>=.PHASER_OVERLOAD [
            ?="PHASER'S OVER LOAD !" ?=()
            @=.DEVICE_BASE+3,1 t=4 J=.OVERLOAD_POWER
          ]
          ~=J h=I K=~
          ?=K ?=" UNITS HIT  KLINGON("
          ?=@(.ENEMY_X_BASE+I-1) ?=@(.ENEMY_Y_BASE+I-1) ?=")" ?=()
          ~=I k=K
          %=@(.ENEMY_HP_BASE+I-1)==0 [ ?="### DESTROYED ###" ?=() ] [ ?="# DAMAGED #" ?=() ]
        ]
        I=I+1
      ]
    ]
    ~=.COMMAND_COMMIT
  ^=3
  ]

; Warp departure ( -- command-status ). I retains factor across n/c;
; J retains cost. x owns the trajectory after the departure commit.
  &=w [
    t=5
  ^=1
    ?=" FACTOR ? " n=()
    B=~ A=~
    %=B==.PARSE_EOF [ ~=.COMMAND_EOF #=3 ]
    %=(B!=.PARSE_VALID)+(A<0)+(A>.WARP_MAX) [ #=1 ]
    %=A==0 [ ~=.COMMAND_CANCEL #=3 ]
    %=(@(.DEVICE_BASE+4)>0)*(A>.DAMAGED_WARP_MAX) [
      ?="TRY 2 AT MOST !" ?=() #=1
    ]
    I=A J=((I*I)+1)/2
    %=@(.SHIP_ENERGY)<J [ ?="WE HAVE NO ENERGY !" ?=() #=1 ]
    c=() A=~ B=~ C=~
    %=A==.COURSE_EOF [ ~=.COMMAND_EOF #=3 ]
    ?="* ION ENGINE START" ?=()
    @=.MISSION_DAYS,@(.MISSION_DAYS)-1
    @=.SHIP_ENERGY,@(.SHIP_ENERGY)-J
    @=.DOCKED,0
    @=.SECTOR_BASE+((@(.SHIP_X)-1)*.SECTOR_LIMIT)+@(.SHIP_Y)-1,0
    K=.DEVICE_BASE
    *=K<.DEVICE_LIMIT [ %=@(K)>0 [ @=K,@(K)-1 ] K=K+1 ]
    ~=I ~=C ~=B x=()
    ~=.COMMAND_COMMIT
  ^=3
  ]

; Torpedo ( -- command-status ). I/J are candidate coordinates, P/G are
; fixed-point coordinates, S/T are direction and K/L are kind/enemy slot.
; Direct scratch A/G/I/J/K/L/P/S/T; c clobbers A..H, k clobbers A..D.
  &=o [
    t=6
    %=(@(.DEVICE_BASE+5)>0)+(@(.SHIP_TORPEDOES)==0) [ ~=.COMMAND_CANCEL #=3 ]
    c=() A=~ T=~ S=~
    %=A==.COURSE_EOF [ ~=.COMMAND_EOF #=3 ]
    @=.SHIP_TORPEDOES,@(.SHIP_TORPEDOES)-1
    ?="ENTERPRISE FIRING TORPEDOES." ?=() ?="TRACK-"
    P=(@(.SHIP_X)*.COURSE_SCALE)+.WARP_HALF
    G=(@(.SHIP_Y)*.COURSE_SCALE)+.WARP_HALF
  ^=1
    P=P+S G=G+T I=P/.COURSE_SCALE J=G/.COURSE_SCALE
    %=(I<1)+(I>.SECTOR_LIMIT)+(J<1)+(J>.SECTOR_LIMIT) [
      ?="MISS" ?=() #=2
    ]
    ?=I ?=J ?="-"
    K=@(.SECTOR_BASE+((I-1)*.SECTOR_LIMIT)+J-1)
    %=K==0 [ #=1 ]
    ?="HIT" ?=()
    %=K==1 [
      L=1
      *=L<=.ENEMY_SLOTS [
        %=(@(.ENEMY_HP_BASE+L-1)>0)*(@(.ENEMY_X_BASE+L-1)==I)*(@(.ENEMY_Y_BASE+L-1)==J) [
          ~=L k=.TORPEDO_DAMAGE
          %=@(.ENEMY_HP_BASE+L-1)==0 [ ?="### DESTROYED ###" ?=() ] [ ?="# DAMAGED #" ?=() ]
          #=2
        ]
        L=L+1
      ]
    ]
    %=(K==.BASE_KIND)+(K==.STAR_KIND) [
      A=(@(.QUADRANT_X)*8)+@(.QUADRANT_Y)-9
      %=K==.BASE_KIND [
        @=A,@(A)-.BASE_UNIT @=.GALAXY_BASES,@(.GALAXY_BASES)-1 @=.DOCKED,0
      ] [ @=A,@(A)-1 ]
      @=.SECTOR_BASE+((I-1)*.SECTOR_LIMIT)+J-1,0
    ]
  ^=2
    ~=.COMMAND_COMMIT
  ^=3
  ]

; Read and dispatch one complete COMMAND line ( -- command-status ).
; Direct scratch A, B, C, D; callees own all persistent writes.
  &=b [
    ?="COMMAND :"
    B=0 C=0 D=1
    *=D [
      A=$
      %=(A==.ASCII_LF)+(A==.PARSE_EOF) [ D=0 ] [
        %=B==0 [
          B=3
          %=(A!=.ASCII_SPACE)*(A!=.ASCII_TAB)*(A!=.ASCII_CR) [ C=A B=1 ]
        ] [
          %=B==1 [
            %=A==.ASCII_CR [ B=2 ] [
              %=(A!=.ASCII_SPACE)*(A!=.ASCII_TAB) [ B=3 ]
            ]
          ] [ %=B==2 [ B=3 ] ]
        ]
      ]
    ]
    %=(B==0)+(B==3) [
      %=A==.PARSE_EOF [ ~=.COMMAND_EOF ] [ ~=.COMMAND_CANCEL ] #=1
    ]
    %=(C>=.ASCII_LOWER_A)*(C<=.ASCII_LOWER_Z) [ C=C-.ASCII_CASE ]
    %=C==.CMD_X [ ~=.COMMAND_EOF #=1 ]
    %=C==.CMD_G [ m=() ~=.COMMAND_CANCEL #=1 ]
    %=C==.CMD_L [ l=() ~=.COMMAND_CANCEL #=1 ]
    %=C==.CMD_S [ s=() ~=.COMMAND_CANCEL #=1 ]
    %=C==.CMD_R [ v=() ~=.COMMAND_CANCEL #=1 ]
    %=C==.CMD_P [ f=() #=1 ]
    %=C==.CMD_W [ w=() #=1 ]
    %=C==.CMD_T [ o=() #=1 ]
    %=C==.CMD_HELP [
      ?="*HELP*" ?=() ?="S : SHORT RANGE SENSOR" ?=()
      ?="G : GALAXY MAP" ?=() ?="L : LONG RANGE SENSOR" ?=()
      ?="P : PHASER" ?=() ?="W : WARP" ?=()
      ?="T : TORPEDOES" ?=() ?="R : STATUS REPORT" ?=()
      ?="X : EXIT" ?=() ?="? : HELP" ?=()
      ~=.COMMAND_CANCEL #=1
    ]
    %=A==.PARSE_EOF [ ~=.COMMAND_EOF ] [ ~=.COMMAND_CANCEL ]
  ^=1
  ]

; EC08_TEST_DEFINITIONS_END
