; Bounded PRNG ( n -- value ). Caller supplies 1..32767.
; Writes A, B and storage[192].
  &=r [
    A=~
    B=(@(192)*25173)+13849
    @=192,B
    B=B%A
    %=B<0 [ B=B+A ]
    ~=B+1
  ]

; Generate a complete galaxy ( -- ). Writes galaxy[0..63], K, B,
; PRNG state and scratch A, C, H, I, J, L, M. r also writes B.
; H holds the enemy distribution parameter across calls and retries.
  &=g [
    r=400
    H=~+599
  ^=1
    I=0 C=0 K=0
    *=I<64 [
      r=100
      J=~-1
      J=J<5
      C=C+J
      r=H
      L=~-1
      M=(L<209)+(L<49)+(L<24)+(L<9)+(L<2)
      K=K+M
      r=8
      L=~-1
      @=I,(M*100)+(J*10)+L
      I=I+1
    ]
    %=(C==0)+(C>=4) [ #=1 ]
    B=C
  ]

; Expand the current quadrant ( -- ). Reads U, V, X, Y and galaxy;
; writes N, sector[71..134], enemy[135..152] and PRNG state.
; Scratch C, H, I, J, L, M, P, R; r clobbers A and B.
  &=q [
    I=71
    *=I<153 [ @=I,0 I=I+1 ]
    @=(X*8)+Y+62,4
    M=@((U*8)+V-9)%1000
    N=M/100
    P=(M%100)/10
    R=M%10
    C=1 H=N I=1
    *=C<=3 [
      *=H>0 [
      ^=1
        r=64
        J=~-1
        M=J+71
        %=@(M)!=0 [ #=1 ]
        @=M,C
        %=C==1 [
          L=(J/8)+1
          J=(J%8)+1
          @=134+I,300
          @=140+I,L
          @=146+I,J
          I=I+1
        ]
        H=H-1
      ]
      C=C+1
      %=C==2 [ H=P ]
      %=C==3 [ H=R ]
    ]
  ]

; EC08_TEST_DEFINITIONS_END
