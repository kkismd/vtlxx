; p consumes address and value, then writes the board through the built-in @ handler.
|=p
V=[
I=[
@=I,V
p=|

; @(C) holds the row in column C, or zero before its first candidate.
C=0
S=0
p=C,0

; Advance the current column's candidate.
^=1
R=@(C)+1
&=R>8 #=2
p=C,R
J=0

; Check earlier columns for a shared row or diagonal.
^=3
&=J==C #=7
P=@(J)
&=P==R #=1
D=P-R
&=D<0 D=0-D
&=D==(C-J) #=1
J=J+1
#=3

; A valid last-column placement is one solution; otherwise descend.
^=7
&=C==7 S=S+1 #=1
C=C+1
p=C,0
#=1

; Clear an exhausted column and backtrack, stopping before column zero.
^=2
p=C,0
C=C-1
&=C<0 #=9
#=1

^=9
?=S
