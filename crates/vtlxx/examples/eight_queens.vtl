; Enumerate all 92 solutions to Eight Queens, then print the solution count.
; From the repository root: cargo run -p vtlxx --bin vtlxx -- crates/vtlxx/examples/eight_queens.vtl
; @(C) stores the row (1..8) of the queen in column C (0..7); zero means empty.
; C is the current column, R its candidate row, and S the solution count.
; J scans earlier columns or prints the board; P, D, and F check collisions.
; The procedures share registers and storage. Each contract below names its effects.

  ; putcell: ( address value -- ). All board writes pass through this procedure.
  ; reads: value stack
  ; writes/clobbers: I, V, indexed storage at address
  &=putcell [
    V=~
    I=~
    @=I,V
  ]

  ; absdiff: ( difference -- absolute difference ).
  ; reads: value stack
  ; writes/clobbers: D
  &=absdiff [
    D=~
    %=D<0 [ D=0-D ]
    ~=D
  ]

  ; collide: ( -- ). Set F when the current candidate collides with an earlier queen.
  ; reads: C, R, indexed storage; calls absdiff
  ; writes/clobbers: F, J, P, D
  &=collide [
    F=0
    J=0
    *=J<C [
      P=@(J)
      %=P==R [
        F=1
        J=C
      ] [
        absdiff=P-R
        D=~
        %=D==(C-J) [
          F=1
          J=C
        ]
      ]
      J=J+1
    ]
  ]

  ; printsol: ( -- ). Print the placed rows in column order, followed by LF.
  ; reads: indexed storage
  ; writes/clobbers: J, output
  &=printsol [
    J=0
    *=J<8 [
      ?=@(J)
      J=J+1
    ]
    ?=()
  ]

  ; descend: ( -- ). Descend to an empty next column.
  ; reads: C; calls putcell
  ; writes/clobbers: C, I, V, indexed storage at the new C
  &=descend [
    C=C+1
    putcell=C,0
  ]

  ; backstep: ( -- ). Clear an exhausted column and backtrack.
  ; reads: C; calls putcell
  ; writes/clobbers: C, I, V, indexed storage at the old C
  &=backstep [
    putcell=C,0
    C=C-1
  ]

  ; search: ( -- ). Advance candidates until backtracking passes column zero.
  ; reads: C, S, indexed storage; calls backstep, collide, descend, printsol, putcell
  ; writes/clobbers: C, R, S, F, J, P, D, I, V, board, output
  &=search [
    *=C>=0 [
      ; Advance this column's row candidate. Exhaustion backtracks.
      R=@(C)+1
      %=R>8 [ backstep=() ] [
        putcell=C,R
        collide=()
        ; A clear candidate completes a solution or descends.
        %=F==0 [
          %=C==7 [
            S=S+1
            printsol=()
          ] [ descend=() ]
        ]
      ]
    ]
  ]

  C=0
  S=0
  putcell=C,0
  search=()
  ?=S
  ?=()
