--- a/src/sim65/paravirt.c
+++ b/src/sim65/paravirt.c
@@ -38,0 +39,2 @@
+#include <poll.h>
+#include <errno.h>
@@ -80,0 +83 @@
+static unsigned long TryReadCount;
@@ -258 +261,6 @@
-    RetVal = read (FD, Data, Count);
+    const char* FailAfter = getenv ("SIM65_WAIT_FAIL_AFTER");
+    if (FD == STDIN_FILENO && FailAfter && TryReadCount++ >= strtoul (FailAfter, 0, 10)) {
+        errno = EIO; RetVal = (unsigned) -1;
+    } else {
+        RetVal = read (FD, Data, Count);
+    }
@@ -271,0 +280,21 @@
+/* Experimental VTLXX-only hook at $FFF0: X=0 byte, 1 not-ready, 2 EOF, 3 fatal. */
+static void PVTryRead (CPURegs* Regs)
+{
+    struct pollfd pfd;
+    unsigned char Byte;
+    int R;
+    const char* Fault = getenv ("SIM65_TRY_FAULT");
+    if (Fault && strcmp (Fault, "EBADF") == 0) close (STDIN_FILENO);
+    if (Fault && strcmp (Fault, "EIO") == 0) { Regs->XR = 3; return; }
+    pfd.fd = STDIN_FILENO; pfd.events = POLLIN; pfd.revents = 0;
+    do { R = poll (&pfd, 1, 0); } while (R < 0 && errno == EINTR);
+    if (R < 0 || (pfd.revents & (POLLERR | POLLNVAL))) { Regs->XR = 3; return; }
+    if (R == 0) { Regs->XR = 1; return; }
+    do { R = read (STDIN_FILENO, &Byte, 1); } while (R < 0 && errno == EINTR);
+    if (R == 1) { Regs->AC = Byte; Regs->XR = 0; }
+    else if (R == 0) { Regs->XR = 2; }
+    else if (errno == EAGAIN || errno == EWOULDBLOCK) { Regs->XR = 1; }
+    else { Regs->XR = 3; }
+}
+
+
@@ -319,0 +349,7 @@
+    /* Experimental extension deliberately leaves all legacy slots unchanged. */
+    if (Regs->PC == 0xFFF0) {
+        PVTryRead (Regs);
+        Regs->PC = Pop(Regs) + (Pop(Regs) << 8) + 1;
+        return;
+    }
+
